<rdf:Description rdf:about="">
	<dc:format>application/pdf</dc:format>
	<dc:title>On the widely differing effects of free trade agreements: Lessons from twenty years of trade integration</dc:title>
	<dc:creator>
		<rdf:Seq>
			<rdf:li>Scott L. Baier</rdf:li>
			<rdf:li>Yoto V. Yotov</rdf:li>
			<rdf:li>Thomas Zylkin</rdf:li>
		</rdf:Seq>
	</dc:creator>
	<dc:subject>
		<rdf:Bag>
			<rdf:li>Free Trade Agreements</rdf:li>
			<rdf:li>International Trade</rdf:li>
			<rdf:li>Structural Gravity</rdf:li>
		</rdf:Bag>
	</dc:subject>
